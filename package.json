{
  "name": "agrocure-backend",
  "version": "1.0.0",
  "description": "AgroCure Backend Infrastructure - NestJS Gateway & FastAPI ML Engine",
  "scripts": {
    "build": "node build.js",
    "start": "node run-concurrent.js",
    "start:bash": "bash start.sh",
    "start:frontend": "cd frontend && npm run dev",
    "start:ml": "cd ml_service && .venv\\Scripts\\python -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "start:orchestrator": "cd orchestrator && npm run start",
    "build:orchestrator": "cd orchestrator && npm run build",
    "build:frontend": "cd frontend && npm run build"
  },
  "keywords": [
    "agrocure",
    "foliar-disease",
    "soybean",
    "nestjs",
    "fastapi"
  ],
  "author": "harshada-05-code",
  "license": "MIT"
}
